{
  "name": "select-and-run-without-debug",
  "displayName": "Select and Run Without Debug",
  "description": "Select and Run Without Debug from command palette.",
  "version": "2.0.0",
  "publisher": "quatters",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quatters/select-and-run-without-debug"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "debug",
    "debugging",
    "command",
    "palette"
  ],
  "icon": "images/icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "select-and-run-without-debug.activate",
        "title": "Select and Run Without Debug",
        "category": "Debug"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run bundle --minify",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "watch": "pnpm run bundle --sourcemap --watch",
    "compile": "tsc -p ./",
    "pretest": "pnpm run compile && pnpm run bundle --sourcemap && pnpm run lint",
    "test": "vscode-test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "package": "vsce package",
    "test:docker": "${CONTAINER_ENGINE:-docker} build -f docker/test.Dockerfile -t select-and-run-without-debug-test . && ${CONTAINER_ENGINE:-docker} run --rm --init -v select-and-run-without-debug-vscode:/app/.vscode-test select-and-run-without-debug-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/sinon": "^22.0.1",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0",
  "files": [
    "dist/extension.js",
    "images/icon.png",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "vsce": {
    "dependencies": false
  }
}
